# Groq API anahtarı (https://console.groq.com). Yalnızca sunucuda kullanılır, tarayıcıya gitmez.
GROQ_API_KEY=

# İsteğe bağlı: kullanılacak Groq modeli. Boş bırakılırsa openai/gpt-oss-120b kullanılır.
GROQ_MODEL=

# Sitenin yayın adresi (sitemap ve canonical için). Vercel'de özel alan adı bağlayınca bunu güncelle.
NEXT_PUBLIC_SITE_URL=https://haberai.bnovative.com.tr
